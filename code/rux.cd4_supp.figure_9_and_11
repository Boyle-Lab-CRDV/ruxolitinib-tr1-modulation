## Supplementary Figure 9F

```{r}
#stacked bar plots of donor proportion per timepoint per cluster
meta <- rux.cd4.harmony@meta.data

plot_data <- meta %>%
  count(timepoint, cluster.id.merge.v2, person, name = "cell_count") %>%
  group_by(timepoint, cluster.id.merge.v2) %>%
  mutate(proportion = cell_count / sum(cell_count)) %>%
  ungroup()

ggplot(plot_data, aes(
  x = cluster.id.merge.v2,
  y = proportion,
  fill = person
)) +
  geom_col(width = 0.8) +
  facet_wrap(~timepoint, ncol = 5) +
  scale_y_continuous(
    labels = scales::percent_format(accuracy = 1),
    limits = c(0, 1),
    expand = c(0, 0)
  ) +
  scale_fill_manual(values = donor_col) +
  labs(
    x = "Cluster",
    y = "Proportion",
    fill = "Donor"
  ) +
  theme_classic()
```


